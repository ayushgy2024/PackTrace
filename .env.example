# Optional override for the local database and recording directory.
# Vercel uses /tmp/packtrace automatically when this is not set.
PACKTRACE_DATA_DIR=

# Google sign-in (create a Google OAuth 2.0 Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate a long random value and set it in Vercel; never commit the real value.
PACKTRACE_SECRET_KEY=

# Separate long random secret used to encrypt Google Drive refresh tokens.
# Never change this after users connect Drive unless they reconnect afterward.
PACKTRACE_TOKEN_ENCRYPTION_KEY=

# Persistent PostgreSQL database (required for Drive connections on Vercel).
DATABASE_URL=

# Optional comma-separated allowlist. Blank permits any verified Google account.
PACKTRACE_ALLOWED_EMAILS=

# Authentication is required by default. Set to 0 only when intentionally disabled.
PACKTRACE_AUTH_REQUIRED=1

# Localhost-only development bypass. It never bypasses sign-in on Vercel.
PACKTRACE_DEV_AUTH_BYPASS=0
