PACKTRACE_SECRET_KEY=replace-with-a-long-random-value
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
PACKTRACE_ALLOWED_EMAILS=your-google-email@example.com

# Local development only. Never enable this in Vercel.
PACKTRACE_DEV_AUTH_BYPASS=0
